    {
        "name"          : "Creating videos from image and audio with moviepy",
        "model"         : "video",
        "enabled"       : false,
        "actions"       :
        [{
            "command"                   : "image-to-video",
            "enabled"                   : true,
            "input-image-path"          : "output/image/joke-start.jpg",
            "output-video-reference"    : "joke-start.mp4"
        },
        {
            "command"                   : "with-audio",
            "enabled"                   : true,
            "input-video-reference"     : "joke-start.mp4",
            "input-audio-reference"     : "joke-start.wav",
            "output-video-reference"    : "joke-start.mp4"
        },
        {
            "command"                   : "image-to-video",
            "enabled"                   : true,
            "input-image-path"          : "output/image/joke-stop.jpg",
            "output-video-reference"    : "joke-stop.mp4"
        },
        {
            "command"                   : "with-audio",
            "enabled"                   : true,
            "input-video-reference"     : "joke-stop.mp4",
            "input-audio-reference"     : "joke-stop.wav",
            "output-video-reference"    : "joke-stop.mp4"
        },
        {
            "command"                   : "merge-videos",
            "enabled"                   : true,
            "input-video-references"    :
            [
                "joke-start.mp4",
                "joke-stop.mp4"
            ],
            "output-video-path"         : "output/video/joke-full.mp4"
        }]
    }]
