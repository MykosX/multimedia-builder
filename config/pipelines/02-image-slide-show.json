                "model-path"            : "MykosX/artemis-anime-sd",
                "prompt"                : "landscape image, a boy and girl having fun on the beach, autumn season",
                "negative-prompt-path"  : "assets/text/negative-prompt.txt",
                "base-image-path"       : "assets/image/couple-having-fun.jpg",
                "width"                 :  768,
                "height"                :  512,
                "guidance-scale"        : 12.0,
