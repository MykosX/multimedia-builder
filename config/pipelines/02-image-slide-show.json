{
    "project-title"     : "Image slide show",
    "activities"        :
    [{
        "name"          : "Describing slide show images",
        "enabled"       : false,
        "model"         : "audio",
        "actions"       :
        [{
            "command"                   : "with-silence",
            "enabled"                   : true,
            "duration"                  : 2.0,
            "output-audio-reference"    : "joke-silence.wav"
        },
        {
            "command"                   : "generate-speech-from-text",
            "enabled"                   : true,
            "adapter"                   : "coqui",
            "parameters"                :
            {
                "model-path"            : "tts_models/en/ljspeech/vits",
                "input-text-path"       : "assets/text/joke-stop.txt",
                "output-audio-reference": "joke-stop.wav",
                "output-audio-path"     : "output/audio/joke-stop.wav"
            }
        }]
    },
    {
        "name"          : "Creating images",
